#!/bin/sh
# 推送前的快速闸门：typecheck + 只跑与本次改动相关的单测。
# 全量单测 / build / migrate / E2E 留给 CI（quality.yml 在 PR 与 master 上都跑全量）。
#
# 单测为什么不跑全量：4800 个用例约 70s，其中 88% 是 58 个文件各自冷加载一遍
# payload.config（每次 6~8s）。scripts/test-changed.mjs 按 import 图只挑受影响的文件，
# 再常驻跑那些用 readFileSync 读源码、按图选不中的契约测试。改两个文件 ≈ 15s，
# 动到 collection 的 PR ≈ 50s。选取规则与退回全量的条件见该脚本头注释。
#
# 本地跑全量：FULL_PREPUSH=1 git push
# 跳过：        SKIP_PREPUSH=1 git push
# 禁止用 --no-verify 绕过（Agent 尤其禁止，见 AGENTS.md 四条红线）。

set -u

APP=payload-office-platform
ZERO=0000000000000000000000000000000000000000

[ "${SKIP_PREPUSH:-0}" = "1" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 1

# 汇总本次推送真正新增的提交所涉及的文件；不碰应用目录就直接放行
#（纯文档分支不必等类型检查）。用 --not --remotes=origin 而不是与 master 比，
# 否则从已推送分支切出的新分支会把上游旧提交一起算进来。
touched=''
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                     # 删除远端分支
  files=$(git log --name-only --pretty=format: "$local_sha" --not --remotes=origin 2>/dev/null) || continue
  touched="$touched
$files"
done

printf '%s\n' "$touched" | grep -q "^$APP/" || exit 0

cd "$root/$APP" || exit 1
if [ ! -d node_modules ]; then
  printf '\033[33m! node_modules 缺失，跳过 pre-push 检查（先 pnpm install）\033[0m\n'
  exit 0
fi

printf '\033[36m→ pre-push: pnpm typecheck\033[0m\n'
pnpm typecheck || { printf '\033[31m✗ typecheck 失败，推送中止（跳过：SKIP_PREPUSH=1）\033[0m\n'; exit 1; }

if [ "${FULL_PREPUSH:-0}" = "1" ]; then
  printf '\033[36m→ pre-push: pnpm test（FULL_PREPUSH=1，全量）\033[0m\n'
  pnpm test || { printf '\033[31m✗ 单测失败，推送中止（跳过：SKIP_PREPUSH=1）\033[0m\n'; exit 1; }
else
  printf '\033[36m→ pre-push: pnpm test:changed（只跑受影响的单测；全量：FULL_PREPUSH=1）\033[0m\n'
  pnpm test:changed || { printf '\033[31m✗ 单测失败，推送中止（跳过：SKIP_PREPUSH=1）\033[0m\n'; exit 1; }
fi

exit 0
