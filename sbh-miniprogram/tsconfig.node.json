{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "miniprogram-api-typings"]
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "miniprogram/config/**/*.ts",
    "miniprogram/services/**/*.ts"
  ]
}
