/* === PRIMITIVE === */
page {
  --sbh-color-gray-50: #f2f2f4;
  --sbh-color-white: #fff;
  --sbh-color-gray-950: #1d1d1f;
  --sbh-color-gray-700: #6e6e73;
  --sbh-color-gray-600: #86868b;
  --sbh-color-gray-200: #e5e5e7;
  --sbh-color-blue-600: #0071e3;
  --sbh-color-transparent: transparent;
  --sbh-space-0: 0;
  --sbh-space-4: 8rpx;
  --sbh-space-6: 12rpx;
  --sbh-space-8: 16rpx;
  --sbh-space-10: 20rpx;
  --sbh-space-12: 24rpx;
  --sbh-space-14: 28rpx;
  --sbh-space-16: 32rpx;
  --sbh-radius-3: 6rpx;
  --sbh-radius-6: 12rpx;
  --sbh-radius-8: 16rpx;
  --sbh-size-12: 24rpx;
  --sbh-size-44: 88rpx;
  --sbh-size-120: 240rpx;
  --sbh-border-width-1: 2rpx;
  --sbh-font-size-10: 20rpx;
  --sbh-font-size-11: 22rpx;
  --sbh-font-size-12: 24rpx;
  --sbh-font-size-13: 26rpx;
  --sbh-font-size-15: 30rpx;
  --sbh-font-size-17: 34rpx;
  --sbh-font-size-19: 38rpx;
  --sbh-font-size-23: 46rpx;
  --sbh-font-size-26: 52rpx;
  --sbh-font-weight-500: 500;
  --sbh-font-weight-600: 600;
  --sbh-line-height-140: 1.4;
  --sbh-line-height-150: 1.5;
  --sbh-opacity-45: 0.45;
  --sbh-opacity-90: 0.9;
  --sbh-duration-120: 120ms;
  --sbh-duration-1200: 1200ms;
  --sbh-scale-98: 0.98;
}

/* === SEMANTIC === */
page {
  --sbh-page-background: var(--sbh-color-gray-50);
  --sbh-surface-background: var(--sbh-color-white);
  --sbh-surface-pressed: var(--sbh-color-gray-50);
  --sbh-text-primary: var(--sbh-color-gray-950);
  --sbh-text-secondary: var(--sbh-color-gray-700);
  --sbh-text-tertiary: var(--sbh-color-gray-600);
  --sbh-border-subtle: var(--sbh-color-gray-200);
  --sbh-border-transparent: var(--sbh-color-transparent);
  --sbh-interaction-primary: var(--sbh-color-blue-600);
  --sbh-interaction-primary-pressed: var(--sbh-color-gray-950);
  --sbh-interaction-on-primary: var(--sbh-color-white);
  --sbh-layout-space-none: var(--sbh-space-0);
  --sbh-layout-space-xs: var(--sbh-space-4);
  --sbh-layout-space-sm: var(--sbh-space-6);
  --sbh-layout-space-md: var(--sbh-space-8);
  --sbh-layout-content-gap: var(--sbh-space-10);
  --sbh-layout-page-gutter: var(--sbh-space-12);
  --sbh-layout-surface-padding: var(--sbh-space-14);
  --sbh-layout-space-lg: var(--sbh-space-16);
  --sbh-shape-label-radius: var(--sbh-radius-3);
  --sbh-shape-control-radius: var(--sbh-radius-6);
  --sbh-shape-surface-radius: var(--sbh-radius-8);
  --sbh-size-skeleton-row: var(--sbh-size-12);
  --sbh-size-touch-target: var(--sbh-size-44);
  --sbh-size-skeleton-media: var(--sbh-size-120);
  --sbh-stroke-default: var(--sbh-border-width-1);
  --sbh-type-tag-size: var(--sbh-font-size-10);
  --sbh-type-auxiliary-size: var(--sbh-font-size-12);
  --sbh-type-metadata-size: var(--sbh-font-size-13);
  --sbh-type-body-size: var(--sbh-font-size-13);
  --sbh-type-label-size: var(--sbh-font-size-15);
  --sbh-type-card-title-size: var(--sbh-font-size-17);
  --sbh-type-section-title-size: var(--sbh-font-size-19);
  --sbh-type-hero-size: var(--sbh-font-size-23);
  --sbh-type-display-size: var(--sbh-font-size-26);
  --sbh-type-medium-weight: var(--sbh-font-weight-500);
  --sbh-type-semibold-weight: var(--sbh-font-weight-600);
  --sbh-type-control-line-height: var(--sbh-line-height-140);
  --sbh-type-body-line-height: var(--sbh-line-height-150);
  --sbh-state-disabled-opacity: var(--sbh-opacity-45);
  --sbh-state-skeleton-low-opacity: var(--sbh-opacity-45);
  --sbh-state-skeleton-high-opacity: var(--sbh-opacity-90);
  --sbh-motion-interaction-duration: var(--sbh-duration-120);
  --sbh-motion-skeleton-duration: var(--sbh-duration-1200);
  --sbh-motion-pressed-scale: var(--sbh-scale-98);
}

/* === COMPONENT === */
page {
  --sbh-button-primary-background: var(--sbh-interaction-primary);
  --sbh-button-primary-pressed-background: var(--sbh-interaction-primary-pressed);
  --sbh-button-primary-text: var(--sbh-interaction-on-primary);
  --sbh-button-secondary-background: var(--sbh-surface-background);
  --sbh-button-secondary-pressed-background: var(--sbh-surface-pressed);
  --sbh-button-secondary-text: var(--sbh-interaction-primary);
  --sbh-button-secondary-border: var(--sbh-interaction-primary);
  --sbh-button-transparent-border: var(--sbh-border-transparent);
  --sbh-button-min-height: var(--sbh-size-touch-target);
  --sbh-button-padding-x: var(--sbh-layout-space-lg);
  --sbh-button-padding-y: var(--sbh-layout-space-sm);
  --sbh-button-border-width: var(--sbh-stroke-default);
  --sbh-button-radius: var(--sbh-shape-control-radius);
  --sbh-button-font-size: var(--sbh-type-body-size);
  --sbh-button-font-weight: var(--sbh-type-medium-weight);
  --sbh-button-line-height: var(--sbh-type-control-line-height);
  --sbh-button-disabled-opacity: var(--sbh-state-disabled-opacity);
  --sbh-button-status-font-size: var(--sbh-type-body-size);
  --sbh-button-status-gap: var(--sbh-layout-space-sm);
  --sbh-button-status-suffix-font-size: var(--sbh-type-auxiliary-size);
  --sbh-button-pressed-scale: var(--sbh-motion-pressed-scale);
  --sbh-button-pressed-duration: var(--sbh-motion-interaction-duration);
  --sbh-card-background: var(--sbh-surface-background);
  --sbh-card-text: var(--sbh-text-primary);
  --sbh-card-radius: var(--sbh-shape-surface-radius);
  --sbh-card-padding: var(--sbh-layout-surface-padding);
  --sbh-card-font-size: var(--sbh-type-body-size);
  --sbh-skeleton-background: var(--sbh-border-subtle);
  --sbh-skeleton-radius: var(--sbh-shape-control-radius);
  --sbh-skeleton-duration: var(--sbh-motion-skeleton-duration);
  --sbh-skeleton-media-height: var(--sbh-size-skeleton-media);
  --sbh-skeleton-media-gap: var(--sbh-layout-space-md);
  --sbh-skeleton-row-height: var(--sbh-size-skeleton-row);
  --sbh-skeleton-row-gap: var(--sbh-layout-space-sm);
  --sbh-skeleton-first-row-gap: var(--sbh-layout-space-none);
  --sbh-skeleton-low-opacity: var(--sbh-state-skeleton-low-opacity);
  --sbh-skeleton-high-opacity: var(--sbh-state-skeleton-high-opacity);
  --sbh-state-padding-y: var(--sbh-layout-space-lg);
  --sbh-state-padding-x: var(--sbh-layout-space-none);
  --sbh-state-marker-color: var(--sbh-text-tertiary);
  --sbh-state-marker-font-size: var(--sbh-type-metadata-size);
  --sbh-state-title-gap: var(--sbh-layout-space-sm);
  --sbh-state-title-color: var(--sbh-text-primary);
  --sbh-state-title-font-size: var(--sbh-type-card-title-size);
  --sbh-state-title-font-weight: var(--sbh-type-semibold-weight);
  --sbh-state-description-gap: var(--sbh-layout-space-xs);
  --sbh-state-description-color: var(--sbh-text-secondary);
  --sbh-state-description-font-size: var(--sbh-type-body-size);
  --sbh-state-description-line-height: var(--sbh-type-body-line-height);
  --sbh-state-action-min-height: var(--sbh-size-touch-target);
  --sbh-state-action-gap: var(--sbh-layout-space-md);
  --sbh-state-action-padding-x: var(--sbh-layout-space-lg);
  --sbh-state-action-padding-y: var(--sbh-layout-space-sm);
  --sbh-state-action-background: var(--sbh-surface-background);
  --sbh-state-action-pressed-background: var(--sbh-surface-pressed);
  --sbh-state-action-pressed-scale: var(--sbh-motion-pressed-scale);
  --sbh-state-action-pressed-duration: var(--sbh-motion-interaction-duration);
  --sbh-state-action-color: var(--sbh-interaction-primary);
  --sbh-state-action-border: var(--sbh-interaction-primary);
  --sbh-state-action-border-width: var(--sbh-stroke-default);
  --sbh-state-action-radius: var(--sbh-shape-control-radius);
  --sbh-state-action-font-size: var(--sbh-type-body-size);
}
