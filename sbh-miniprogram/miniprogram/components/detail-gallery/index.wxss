:host {
  box-sizing: border-box;
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.detail-gallery {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.detail-gallery__swiper {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-height: var(--sbh-size-touch-target);
  height: auto;
  aspect-ratio: 4 / 3;
}

.detail-gallery__media,
.detail-gallery__image,
.detail-gallery__placeholder,
.detail-gallery__empty {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

.detail-gallery__media {
  overflow: hidden;
  background: var(--sbh-surface-pressed);
  border-radius: var(--sbh-shape-control-radius);
}

.detail-gallery__image {
  display: block;
}

.detail-gallery__placeholder,
.detail-gallery__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--sbh-size-touch-target);
  padding: var(--sbh-layout-space-md);
  color: var(--sbh-text-tertiary);
  background: var(--sbh-surface-pressed);
  border-radius: var(--sbh-shape-control-radius);
  font-size: var(--sbh-type-body-size);
  line-height: var(--sbh-type-body-line-height);
}

.detail-gallery__empty {
  aspect-ratio: 4 / 3;
}

.detail-gallery__counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 999px;
  font-size: 22rpx;
  line-height: 1.2;
}

.num {
  font-variant-numeric: tabular-nums;
}
