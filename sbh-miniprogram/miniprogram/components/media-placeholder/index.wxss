:host {
  display: block;
  width: 100%;
  height: 100%;
}

.media-placeholder {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: var(--sbh-layout-space-sm);
  color: var(--sbh-text-tertiary);
  background: var(--sbh-surface-pressed);
}

.media-placeholder__skyline {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 76rpx;
  height: 56rpx;
  gap: 6rpx;
  opacity: 0.46;
}

.media-placeholder__tower {
  box-sizing: border-box;
  width: 18rpx;
  border: var(--sbh-stroke-default) solid currentColor;
  border-bottom-width: 4rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.media-placeholder__tower--short {
  height: 32rpx;
}

.media-placeholder__tower--medium {
  height: 42rpx;
}

.media-placeholder__tower--tall {
  height: 54rpx;
}

.media-placeholder--detail .media-placeholder__skyline {
  transform: scale(1.2);
  transform-origin: center bottom;
}

.media-placeholder__label {
  margin-top: var(--sbh-layout-space-sm);
  color: var(--sbh-text-tertiary);
  font-size: var(--sbh-type-auxiliary-size);
  line-height: var(--sbh-type-body-line-height);
}
