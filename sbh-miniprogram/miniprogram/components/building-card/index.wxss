:host {
  display: block;
}

.num {
  font-variant-numeric: tabular-nums;
}

.building-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--sbh-layout-content-gap, 20rpx);
  padding: var(--sbh-layout-surface-padding, 28rpx) 0;
  overflow: hidden;
  color: var(--sbh-text-primary, #1d1d1f);
  background: var(--sbh-surface-background, #ffffff);
  transition: background var(--sbh-motion-interaction-duration, 120ms) ease, transform var(--sbh-motion-interaction-duration, 120ms) ease;
}

.building-card--pressed {
  background: var(--sbh-surface-pressed, #f2f2f4);
  transform: scale(var(--sbh-motion-pressed-scale, 0.98));
}

.building-card--inactive {
  opacity: 0.78;
}

.building-card__media {
  flex: 0 0 192rpx;
  width: 192rpx;
  height: 144rpx;
  overflow: hidden;
  border-radius: var(--sbh-shape-control-radius, 12rpx);
  background: var(--sbh-surface-pressed, #ececee);
}

.building-card__media image,
.building-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.building-card__placeholder {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sbh-text-tertiary, #86868b);
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
}

.building-card__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

.building-card__title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  color: var(--sbh-text-primary, #1d1d1f);
  font-size: var(--sbh-type-label-size, 30rpx);
  font-weight: var(--sbh-type-semibold-weight, 600);
  line-height: var(--sbh-type-control-line-height, 1.4);
}

.building-card__facts,
.building-card__location {
  overflow: hidden;
  color: var(--sbh-text-secondary, #6e6e73);
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
  line-height: var(--sbh-type-body-line-height, 1.5);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.building-card__location {
  color: var(--sbh-text-tertiary, #86868b);
}

.building-card__supply {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
  color: var(--sbh-text-secondary, #6e6e73);
}

.building-card__supply-count {
  font-size: var(--sbh-type-card-title-size, 34rpx);
  font-weight: var(--sbh-type-semibold-weight, 600);
  color: var(--sbh-text-primary, #1d1d1f);
}

.building-card__supply-price {
  font-weight: var(--sbh-type-semibold-weight, 600);
  color: var(--sbh-text-primary, #1d1d1f);
  font-size: 28rpx;
}

.building-card__inquiry-action {
  flex: 0 0 auto;
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
  color: var(--sbh-interaction-primary, #0071e3);
  border: 1px solid #d7d7db;
  border-radius: var(--sbh-shape-control-radius, 12rpx);
  padding: 10rpx 20rpx;
  line-height: 1;
}
