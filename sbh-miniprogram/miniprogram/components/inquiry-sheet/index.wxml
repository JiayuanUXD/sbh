<view
  wx:if="{{snapshot && snapshot.state !== 'closed'}}"
  class="inquiry-sheet sbh-sheet"
  aria-role="dialog"
  aria-modal="true"
  aria-label="咨询顾问"
>
  <view class="inquiry-sheet__backdrop sbh-sheet__backdrop" catchtap="handleClose" catchtouchmove="handleTouchMove"></view>
  <view class="inquiry-sheet__panel sbh-sheet__panel" aria-busy="{{snapshot.busy}}" catchtap="handlePanelTap">
    <view class="inquiry-sheet__grabber" aria-hidden="true"><view class="inquiry-sheet__grabber-line"></view></view>
    <view class="inquiry-sheet__header sbh-sheet__header">
      <view class="inquiry-sheet__header-copy">
        <view class="inquiry-sheet__heading">咨询顾问</view>
        <view class="inquiry-sheet__subtitle">留下需求，顾问将按当前信息跟进</view>
      </view>
      <button
        class="inquiry-sheet__close"
        bindtap="handleClose"
        disabled="{{snapshot.state === 'authorizing' || snapshot.state === 'submitting'}}"
        aria-label="关闭咨询弹层"
      >×</button>
    </view>

    <scroll-view class="inquiry-sheet__body sbh-sheet__body" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="inquiry-sheet__summary">
        <view class="inquiry-sheet__title">{{snapshot.context.title}}</view>
        <view class="inquiry-sheet__summary-line num">
          <text>{{snapshot.context.facts.area}}</text>
          <text>{{snapshot.context.facts.unitPrice}}</text>
          <text>{{snapshot.context.facts.monthlyEstimate}}</text>
        </view>
      </view>

      <view wx:if="{{snapshot.state !== 'success'}}" class="inquiry-sheet__form">
        <view class="inquiry-sheet__field">
          <text class="inquiry-sheet__label">期望入驻时间</text>
          <input
            class="inquiry-sheet__input"
            value="{{snapshot.moveInTime}}"
            maxlength="100"
            placeholder="例如：2026 年 10 月"
            adjust-position="{{true}}"
            cursor-spacing="24"
            disabled="{{snapshot.busy}}"
            bindinput="handleMoveInInput"
          />
        </view>

        <view class="inquiry-sheet__field">
          <text class="inquiry-sheet__label">联系方式</text>
          <view class="inquiry-sheet__phone-segment">
            <button
              class="inquiry-sheet__phone-segment-option {{snapshot.phoneMode === 'wechat' ? 'inquiry-sheet__phone-segment-option--active' : ''}}"
              bindtap="handleSelectWechat"
              disabled="{{snapshot.busy}}"
            >微信手机号</button>
            <button
              class="inquiry-sheet__manual-entry inquiry-sheet__phone-segment-option {{snapshot.phoneMode === 'manual' ? 'inquiry-sheet__phone-segment-option--active' : ''}}"
              bindtap="handleSelectManual"
              disabled="{{snapshot.busy}}"
            >手动填写</button>
          </view>
          <view wx:if="{{snapshot.phoneMode === 'wechat'}}" class="inquiry-sheet__mode-hint">
            提交时由微信授权当前账号绑定的手机号
          </view>
          <input
            wx:if="{{snapshot.phoneMode === 'manual'}}"
            class="inquiry-sheet__input inquiry-sheet__phone num"
            type="number"
            value="{{snapshot.phone}}"
            maxlength="20"
            placeholder="请输入中国大陆手机号"
            adjust-position="{{true}}"
            cursor-spacing="24"
            disabled="{{snapshot.busy}}"
            bindinput="handlePhoneInput"
          />
        </view>

        <view class="inquiry-sheet__privacy">
          <checkbox-group bindchange="handleConsentChange">
            <label class="inquiry-sheet__privacy-check">
              <checkbox
                value="accepted"
                checked="{{snapshot.consentAccepted}}"
                disabled="{{snapshot.privacyStatus !== 'available' || snapshot.busy}}"
              />
              <text>我已阅读并同意隐私政策（{{snapshot.context.policyVersion}}）</text>
            </label>
          </checkbox-group>
          <button
            class="inquiry-sheet__privacy-link"
            bindtap="handlePrivacy"
            disabled="{{snapshot.privacyStatus === 'checking' || snapshot.busy}}"
          >{{snapshot.privacyStatus === 'unavailable' ? '重试打开隐私保护指引' : '打开隐私保护指引'}}</button>
        </view>

        <view
          wx:if="{{snapshot.errorMessage || snapshot.privacyStatus === 'unavailable'}}"
          class="inquiry-sheet__live"
          aria-role="status"
          aria-live="assertive"
          aria-atomic="true"
        >{{snapshot.errorMessage || '暂时无法打开隐私保护指引，请重试'}}</view>
      </view>

      <view wx:else class="inquiry-sheet__success" aria-role="status" aria-live="polite">
        <view class="inquiry-sheet__success-mark" aria-hidden="true">✓</view>
        <view class="inquiry-sheet__success-title">{{snapshot.successMessage}}</view>
        <view class="inquiry-sheet__success-follow-up">{{snapshot.successFollowUp}}</view>
      </view>
    </scroll-view>

    <view class="inquiry-sheet__footer sbh-sheet__footer">
      <button
        wx:if="{{snapshot.state === 'success'}}"
        class="inquiry-sheet__submit"
        bindtap="handleClose"
      >完成</button>
      <button
        wx:elif="{{snapshot.phoneMode === 'wechat'}}"
        class="inquiry-sheet__submit inquiry-sheet__wechat inquiry-sheet__wechat-submit"
        open-type="getPhoneNumber"
        bindgetphonenumber="handlePhoneAuthorization"
        disabled="{{snapshot.phoneSubmitDisabled}}"
      >{{snapshot.state === 'submitting' ? '正在提交' : '使用微信手机号提交'}}</button>
      <button
        wx:else
        class="inquiry-sheet__submit"
        bindtap="handleManualSubmit"
        disabled="{{snapshot.manualSubmitDisabled}}"
      >{{snapshot.state === 'submitting' ? '正在提交' : '提交咨询'}}</button>
    </view>
  </view>
</view>
