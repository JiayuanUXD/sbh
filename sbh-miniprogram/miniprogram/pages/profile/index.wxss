.profile-page {
  min-height: 100vh;
  background: var(--sbh-color-neutral-subtle, #f2f2f4);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 用户身份卡 */
.profile-user-card {
  background: #ffffff;
  padding: 32rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 2rpx solid #e5e5e7;
}

.profile-avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e8e8ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  font-size: 44rpx;
}

.profile-user-info {
  flex: 1;
  min-width: 0;
}

.profile-username {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--sbh-color-neutral-solid, #1d1d1f);
}

.profile-user-city {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
}

.profile-arrow {
  font-size: 28rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
  font-weight: 400;
}

/* 4 格核心资产指标卡 */
.profile-metrics-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx 0;
}

.profile-metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.profile-metric-item {
  text-align: center;
  padding: 8rpx 0;
}

.profile-metric-num {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--sbh-color-neutral-solid, #1d1d1f);
}

.profile-metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

/* 我的留资卡块 */
.profile-inquiry-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 0 28rpx;
}

.profile-inquiry-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.profile-inquiry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sbh-color-neutral-solid, #1d1d1f);
}

.profile-inquiry-status-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
}

.profile-divider {
  height: 2rpx;
  background: #e5e5e7;
}

.profile-inquiry-list {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-inquiry-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-inquiry-media {
  flex: none;
  width: 112rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #e8e8ea;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-inquiry-thumb {
  width: 100%;
  height: 100%;
}

.profile-inquiry-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-inquiry-ph-icon {
  font-size: 36rpx;
}

.profile-inquiry-content {
  flex: 1;
  min-width: 0;
}

.profile-inquiry-target-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sbh-color-neutral-solid, #1d1d1f);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-inquiry-date-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
}

.profile-inquiry-badge {
  flex: none;
  font-size: 22rpx;
  color: #6e6e73;
  background: #f5f5f7;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
}

.profile-inquiry-empty {
  padding: 36rpx 0;
  text-align: center;
}

.profile-inquiry-empty-text {
  font-size: 24rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
  line-height: 1.5;
}

/* 菜单列表卡块 */
.profile-menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 0 28rpx;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.profile-menu-label {
  font-size: 30rpx;
  color: var(--sbh-color-neutral-solid, #1d1d1f);
}

.profile-menu-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--sbh-color-neutral-muted, #86868b);
}

/* 页脚版本信息 */
.profile-footer {
  text-align: center;
  font-size: 22rpx;
  color: #a1a1a6;
  padding: 24rpx 0 16rpx;
}

.sbh-pressable:active {
  transform: scale(0.98);
  opacity: 0.85;
}
