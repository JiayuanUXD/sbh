.building-detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  color: var(--sbh-text-primary, #1d1d1f);
  background: var(--sbh-page-background, #f2f2f4);
}

.num {
  font-variant-numeric: tabular-nums;
}

.sbh-tag {
  font-size: 20rpx;
  color: #6e6e73;
  background: #f5f5f7;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.sbh-pressable {
  opacity: 0.8;
  transform: scale(0.98);
}

.building-gallery {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: #e8e8ea;
}

.building-gallery__swiper,
.building-gallery__image {
  width: 100%;
  height: 100%;
}

.building-gallery__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #a1a1a6;
  font-size: 24rpx;
}

.building-gallery__badge {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
}

.building-header-card,
.building-stats-card,
.building-listings-card,
.building-params-card,
.building-location-card,
.building-comparable-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.building-title {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1d1d1f;
}

.building-address {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6e6e73;
}

.building-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 24rpx;
}

.building-stats-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.building-stat-item {
  text-align: center;
}

.building-stat-label {
  font-size: 24rpx;
  color: #86868b;
}

.building-stat-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.building-section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 24rpx;
}

.building-group-header {
  padding: 16rpx 0 8rpx;
}

.building-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #86868b;
}

.building-listing-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #e5e5e7;
}

.building-listing-media {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 112rpx;
  border-radius: 12rpx;
  background: #e8e8ea;
  overflow: hidden;
}

.building-listing-image {
  width: 100%;
  height: 100%;
}

.building-listing-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 20rpx;
  color: #a1a1a6;
}

.building-listing-info {
  flex: 1;
  min-width: 0;
}

.building-listing-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.building-listing-facts {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.building-listing-price-col {
  flex: 0 0 auto;
  text-align: right;
}

.building-listing-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.building-param-row,
.building-commute-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #e5e5e7;
  font-size: 26rpx;
}

.building-param-label,
.building-commute-label {
  color: #6e6e73;
}

.building-param-value,
.building-commute-value {
  color: #1d1d1f;
  font-weight: 500;
}

.building-map-preview {
  height: 200rpx;
  border-radius: 12rpx;
  background: #ececed;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.building-map-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.building-map-pin {
  font-size: 36rpx;
}

.building-map-name {
  font-size: 24rpx;
  color: #6e6e73;
}

.building-comparable-row {
  display: flex;
  gap: 20rpx;
}

.building-comparable-item {
  flex: 1;
  min-width: 0;
}

.building-comparable-media {
  height: 144rpx;
  border-radius: 12rpx;
  background: #e8e8ea;
  overflow: hidden;
}

.building-comparable-image {
  width: 100%;
  height: 100%;
}

.building-comparable-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 20rpx;
  color: #a1a1a6;
}

.building-comparable-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.building-comparable-stock {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

.building-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e5e7;
}

.building-bottom-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 88rpx;
}

.building-fav-icon {
  font-size: 36rpx;
  color: #1d1d1f;
}

.building-fav-text {
  font-size: 20rpx;
  color: #6e6e73;
}

.building-bottom-cta {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--sbh-interaction-primary, #0071e3);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.building-detail-loading,
.building-detail-error,
.building-detail-not-found {
  margin: 40rpx 24rpx;
}
