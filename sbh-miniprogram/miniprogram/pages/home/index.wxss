.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 64rpx;
  background: var(--sbh-page-background, #f2f2f4);
}

.num {
  font-variant-numeric: tabular-nums;
}

/* 1. Hero 叙事区（视频/图片背景 + 遮罩） */
.home-brand {
  box-sizing: border-box;
  position: relative;
  height: 350rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #4a4d52 0%, #3b3e43 55%, #33363a 100%);
  overflow: hidden;
}

.home-brand__video,
.home-brand__poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-brand__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(rgba(0, 0, 0, 0.44), rgba(0, 0, 0, 0.24) 55%, rgba(0, 0, 0, 0.5));
}

.home-brand__content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 32rpx 36rpx;
}

.home-brand__eyebrow {
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
  font-weight: var(--sbh-type-medium-weight, 500);
  letter-spacing: 1rpx;
}

.home-brand__title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: var(--sbh-type-semibold-weight, 600);
  line-height: var(--sbh-type-control-line-height, 1.4);
  color: #ffffff;
}

.home-brand__description,
.home-brand__stats {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--sbh-type-body-size, 26rpx);
  line-height: var(--sbh-type-body-line-height, 1.5);
}

.home-brand__stats {
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--sbh-type-auxiliary-size, 24rpx);
}

/* 2. 悬浮搜索框 (-29px / -58rpx) */
.home-search {
  position: relative;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 104rpx;
  margin: -52rpx 24rpx 0;
  padding: 0 16rpx 0 28rpx;
  background: #ffffff;
  border-radius: var(--sbh-shape-control-radius, 12rpx);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.home-search__city {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-right: 20rpx;
  font-size: 22rpx;
  font-weight: var(--sbh-type-medium-weight, 500);
  color: var(--sbh-text-secondary, #6e6e73);
  white-space: nowrap;
}

.home-search__input {
  box-sizing: border-box;
  flex: 1;
  height: 100%;
  min-width: 0;
  color: var(--sbh-text-primary, #1d1d1f);
  font-size: 26rpx;
}

.home-search__submit {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: var(--sbh-interaction-primary, #0071e3);
  border-radius: var(--sbh-shape-control-radius, 12rpx);
  transition: transform 120ms ease, opacity 120ms ease;
}

.home-search__submit--pressed {
  opacity: 0.85;
  transform: scale(0.96);
}

.home-search__icon-wrap {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.home-search__icon-circle {
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.home-search__icon-handle {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 12rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 2rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}

/* 加载与错误态 */
.home-loading,
.home-error {
  margin: 32rpx 24rpx;
}

.home-refresh-error {
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx 0;
  color: #86868b;
  font-size: 24rpx;
  background: #ffffff;
  border-radius: var(--sbh-shape-surface-radius, 16rpx);
}

/* 3. 精选好楼 */
.home-buildings-card {
  box-sizing: border-box;
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--sbh-shape-surface-radius, 16rpx);
}

.home-buildings__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.home-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.home-buildings__all {
  font-size: 24rpx;
  color: var(--sbh-interaction-primary, #0071e3);
}

.home-buildings__list {
  margin-top: 24rpx;
}

.home-buildings__divider {
  height: 2rpx;
  margin-left: 212rpx;
  background: #e5e5e7;
}

/* 4. 快捷筛选维度（横向轻量滑动） */
.home-quick-filters {
  margin: 16rpx 24rpx 0;
}

.home-quick-filter-group__scroll {
  width: 100%;
  white-space: nowrap;
}

.home-quick-filter-group__options {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.home-quick-filter {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  color: #6e6e73;
  font-size: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5e5e7;
  border-radius: var(--sbh-shape-control-radius, 12rpx);
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 120ms ease;
}

.home-quick-filter--pressed {
  background: #f2f2f4;
}

.home-quick-filter__count {
  color: #86868b;
  font-size: 22rpx;
}

.home-entrust-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  gap: 24rpx;
  background: var(--sbh-surface-background);
  border-radius: var(--sbh-shape-surface-radius);
}

.home-entrust-card__title {
  color: var(--sbh-text-primary);
  font-size: var(--sbh-type-label-size);
  font-weight: var(--sbh-type-semibold-weight);
}

.home-entrust-card__description {
  margin-top: 6rpx;
  color: var(--sbh-text-secondary);
  font-size: var(--sbh-type-auxiliary-size);
  line-height: var(--sbh-type-body-line-height);
}

.home-entrust-card__action {
  flex: 0 0 auto;
  min-height: var(--sbh-size-touch-target);
  margin: 0;
  padding: 0 28rpx;
  color: var(--sbh-interaction-on-primary);
  background: var(--sbh-interaction-primary);
  border-radius: 999rpx;
  font-size: var(--sbh-type-body-size);
  font-weight: var(--sbh-type-semibold-weight);
}

.home-entrust-card__action::after { border: 0; }

/* 5. 精选房源卡块容器（内嵌细线分隔） */
.home-featured {
  margin-top: 24rpx;
}

.home-featured__heading {
  margin: 0 24rpx 12rpx;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 600;
}

.home-featured__card {
  box-sizing: border-box;
  margin: 0 24rpx;
  background: #ffffff;
  border-radius: var(--sbh-shape-surface-radius, 16rpx);
  overflow: hidden;
}

.home-featured__divider {
  height: 2rpx;
  margin: 0 28rpx;
  background: #e5e5e7;
}
