<view id="home-ready" class="home-page">
  <view class="home-brand">
    <video
      wx:if="{{heroVideoUrl && !videoFailed}}"
      class="home-brand__video"
      src="{{heroVideoUrl}}"
      autoplay="{{true}}"
      loop="{{true}}"
      muted="{{true}}"
      show-play-btn="{{false}}"
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      enable-progress-gesture="{{false}}"
      object-fit="cover"
      binderror="handleVideoError"
    />
    <image
      wx:elif="{{heroPosterUrl && !imageFailed}}"
      class="home-brand__poster"
      src="{{heroPosterUrl}}"
      mode="aspectFill"
      binderror="handleImageError"
    />
    <view class="home-brand__scrim"></view>
    <view class="home-brand__content">
      <view class="home-brand__eyebrow">上海 · 在租房源实时同步</view>
      <view class="home-brand__title">把每一平米算清楚</view>
      <view wx:if="{{content}}" class="home-brand__stats num">
        {{content.stats.listings}} 套在租房源 · {{content.stats.buildings}} 座精选楼宇
      </view>
    </view>
  </view>

  <view class="home-search">
    <view class="home-search__city">上海<text class="home-search__arrow">▾</text></view>
    <view class="home-search__divider"></view>
    <input
      class="home-search__input"
      value="{{keyword}}"
      placeholder="商圈 / 楼盘 / 地铁站"
      confirm-type="search"
      bindinput="handleKeywordInput"
      bindconfirm="handleSearchSubmit"
    />
    <view
      class="home-search__submit"
      hover-class="home-search__submit--pressed"
      hover-stay-time="70"
      aria-role="button"
      aria-label="提交搜索"
      bindtap="handleSearchSubmit"
    >
      <view class="home-search__icon-wrap">
        <view class="home-search__icon-circle"></view>
        <view class="home-search__icon-handle"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-loading">
    <sbh-skeleton rows="4" with-media />
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-error">
    <sbh-state
      kind="error"
      title="首页内容暂时无法加载"
      description="请检查网络后重试"
      action-label="重新加载"
      bindretry="handleRetry"
    />
  </view>

  <block wx:elif="{{state === 'ready' && content}}">
    <view wx:if="{{refreshError}}" class="home-refresh-error" aria-role="status">
      刷新未完成，当前仍显示上次内容
    </view>

    <!-- 快捷双入口 -->
    <view class="home-shortcuts">
      <view class="home-shortcut-card" hover-class="home-card--pressed" hover-stay-time="70" bindtap="handleInquiryCustom">
        <view class="home-shortcut-title">委托找房</view>
        <view class="home-shortcut-desc">说需求，顾问帮你筛</view>
      </view>
      <view class="home-shortcut-card" hover-class="home-card--pressed" hover-stay-time="70" bindtap="handleBrowseAll">
        <view class="home-shortcut-title">售卖专区</view>
        <view class="home-shortcut-desc num">最低 12,000 元/㎡</view>
      </view>
    </view>

    <!-- 真实供给背书条 -->
    <view class="home-assurance" hover-class="home-card--pressed" hover-stay-time="70" bindtap="handleAssuranceTap">
      <view class="home-assurance__left">
        <text class="home-assurance__badge">真实供给</text>
        <text class="home-assurance__text">面积与租金逐条核过</text>
      </view>
      <text class="home-assurance__arrow">了解 ›</text>
    </view>

    <!-- 精选好楼横排 3 格 -->
    <view class="home-buildings-card">
      <view class="home-buildings__heading">
        <view class="home-card-title">精选好楼</view>
        <view class="home-buildings__all" bindtap="handleBrowseBuildings">全部楼盘 ›</view>
      </view>
      <view class="home-buildings__grid">
        <view class="home-building-item" hover-class="home-item--pressed" hover-stay-time="70" bindtap="handleBuildingOpenDirect" data-slug="heng-long-plaza">
          <view class="home-building-item__media">
            <text class="home-building-item__img-text">图</text>
          </view>
          <view class="home-building-item__name">恒隆广场</view>
          <view class="home-building-item__desc num">14 套 · 10.2 起</view>
        </view>
        <view class="home-building-item" hover-class="home-item--pressed" hover-stay-time="70" bindtap="handleBuildingOpenDirect" data-slug="wheelock-square">
          <view class="home-building-item__media">
            <text class="home-building-item__img-text">图</text>
          </view>
          <view class="home-building-item__name">越洋国际广场</view>
          <view class="home-building-item__desc num">9 套 · 6.8 起</view>
        </view>
        <view class="home-building-item" hover-class="home-item--pressed" hover-stay-time="70" bindtap="handleBuildingOpenDirect" data-slug="hkri-taikoo-hui">
          <view class="home-building-item__media">
            <text class="home-building-item__img-text">图</text>
          </view>
          <view class="home-building-item__name">兴业太古汇</view>
          <view class="home-building-item__desc num">7 套 · 11.4 起</view>
        </view>
      </view>
    </view>

    <!-- 快捷筛选维度（单行滑动） -->
    <view class="home-quick-filters">
      <scroll-view class="home-quick-filter-group__scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="home-quick-filter-group__options">
          <block wx:for="{{content.quickFilters}}" wx:key="id">
            <view
              wx:for="{{item.options}}"
              wx:key="value"
              class="home-quick-filter"
              hover-class="home-quick-filter--pressed"
              hover-stay-time="70"
              aria-role="link"
              data-query="{{item.query}}"
              bindtap="handleQuickFilter"
            >
              <text>{{item.label}}</text>
              <text class="home-quick-filter__count num">{{item.count}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 推荐流导航 Tabs -->
    <view class="home-stream-tabs">
      <view class="home-stream-tab home-stream-tab--active">
        <text>推荐</text>
        <view class="home-stream-tab__indicator"></view>
      </view>
      <view class="home-stream-tab" bindtap="handleBrowseAll">附近</view>
      <view class="home-stream-tab" bindtap="handleBrowseAll">新上</view>
    </view>

    <!-- 精选房源列表容器 -->
    <view class="home-featured">
      <view wx:if="{{content.featuredListings.length}}" class="home-featured__card">
        <block wx:for="{{content.featuredListings}}" wx:key="id">
          <listing-card
            borderless="{{true}}"
            listing="{{item}}"
            bindopen="handleListingOpen"
          />
          <view wx:if="{{index < content.featuredListings.length - 1}}" class="home-featured__divider"></view>
        </block>
      </view>
      <sbh-state
        wx:else
        kind="empty"
        title="暂无精选房源"
        description="可以先查看全部在租房源"
      />
    </view>
  </block>
</view>
