<page-meta page-style="{{inquiryOpen ? 'overflow: hidden;' : ''}}" />
<view id="home-ready" class="home-page" aria-hidden="{{inquiryOpen}}">
  <view class="home-brand">
    <video
      wx:if="{{heroVideoUrl && !videoFailed}}"
      class="home-brand__video"
      src="{{heroVideoUrl}}"
      autoplay="{{true}}"
      loop="{{true}}"
      muted="{{true}}"
      show-play-btn="{{false}}"
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      enable-progress-gesture="{{false}}"
      object-fit="cover"
      binderror="handleVideoError"
    />
    <image
      wx:elif="{{heroPosterUrl && !imageFailed}}"
      class="home-brand__poster"
      src="{{heroPosterUrl}}"
      mode="aspectFill"
      binderror="handleImageError"
    />
    <view class="home-brand__scrim"></view>
    <view class="home-brand__content">
      <view class="home-brand__eyebrow">上海 · 商办租赁</view>
      <view class="home-brand__title">把每一平米算清楚</view>
      <view wx:if="{{content}}" class="home-brand__stats num">
        {{content.stats.listings}} 套房源 · {{content.stats.buildings}} 个楼盘
      </view>
    </view>
  </view>

  <view class="home-search">
    <view class="home-search__city">上海<text class="home-search__arrow">▾</text></view>
    <view class="home-search__divider"></view>
    <input
      class="home-search__input"
      value="{{keyword}}"
      placeholder="商圈 / 楼盘 / 地铁站"
      confirm-type="search"
      bindinput="handleKeywordInput"
      bindconfirm="handleSearchSubmit"
    />
    <view
      class="home-search__submit"
      hover-class="home-search__submit--pressed"
      hover-stay-time="70"
      aria-role="button"
      aria-label="提交搜索"
      bindtap="handleSearchSubmit"
    >
      <view class="home-search__icon-wrap">
        <view class="home-search__icon-circle"></view>
        <view class="home-search__icon-handle"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-loading">
    <sbh-skeleton rows="4" with-media />
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-error">
    <sbh-state
      kind="error"
      title="首页内容暂时无法加载"
      description="请检查网络后重试"
      action-label="重新加载"
      bindretry="handleRetry"
    />
  </view>

  <block wx:elif="{{state === 'ready' && content}}">
    <view wx:if="{{refreshError}}" class="home-refresh-error" aria-role="status">
      刷新未完成，当前仍显示上次内容
    </view>

    <!-- Mini 首页 DTO 返回的精选楼盘 -->
    <view class="home-buildings-card">
      <view class="home-buildings__heading">
        <view class="home-card-title">精选好楼</view>
        <view class="home-buildings__all" bindtap="handleBrowseBuildings">全部楼盘 ›</view>
      </view>
      <view wx:if="{{content.featuredBuildings.length}}" class="home-buildings__list">
        <block wx:for="{{content.featuredBuildings}}" wx:key="id">
          <building-card
            building="{{item}}"
            bindopen="handleBuildingOpenDirect"
          />
          <view wx:if="{{index < content.featuredBuildings.length - 1}}" class="home-buildings__divider"></view>
        </block>
      </view>
      <sbh-state
        wx:if="{{!content.featuredBuildings.length}}"
        kind="empty"
        title="暂无精选楼盘"
        description="可以查看全部楼盘"
      />
    </view>

    <!-- 快捷筛选维度（单行滑动） -->
    <view class="home-quick-filters">
      <scroll-view class="home-quick-filter-group__scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="home-quick-filter-group__options">
          <block wx:for="{{content.quickFilters}}" wx:key="id">
            <view
              wx:for="{{item.options}}"
              wx:key="value"
              class="home-quick-filter"
              hover-class="home-quick-filter--pressed"
              hover-stay-time="70"
              aria-role="link"
              data-query="{{item.query}}"
              bindtap="handleQuickFilter"
            >
              <text>{{item.label}}</text>
              <text class="home-quick-filter__count num">{{item.count}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view class="home-entrust-card">
      <view>
        <view class="home-entrust-card__title">还没找到合适的办公室？</view>
        <view class="home-entrust-card__description">告诉我们面积、预算与入驻时间，顾问按公开房源匹配。</view>
      </view>
      <button class="home-entrust-card__action" bindtap="handleOpenInquiry" disabled="{{inquiryOpen}}">委托找房</button>
    </view>

    <!-- Mini 首页 DTO 返回的精选房源 -->
    <view class="home-featured">
      <view class="home-featured__heading">精选房源</view>
      <view wx:if="{{content.featuredListings.length}}" class="home-featured__card">
        <block wx:for="{{content.featuredListings}}" wx:key="id">
          <listing-card
            borderless="{{true}}"
            listing="{{item}}"
            bindopen="handleListingOpen"
          />
          <view wx:if="{{index < content.featuredListings.length - 1}}" class="home-featured__divider"></view>
        </block>
      </view>
      <sbh-state
        wx:else
        kind="empty"
        title="暂无精选房源"
        description="可以先查看全部在租房源"
      />
    </view>
  </block>
</view>

<inquiry-sheet
  id="inquiry-sheet"
  snapshot="{{inquirySheet}}"
  bindclose="handleInquiryClose"
  bindprivacy="handleInquiryPrivacy"
  bindmoveinchange="handleInquiryMoveInChange"
  bindphonechange="handleInquiryPhoneChange"
  bindselectmanual="handleInquirySelectManual"
  bindselectwechat="handleInquirySelectWechat"
  bindconsentchange="handleInquiryConsentChange"
  bindphoneauthorize="handleInquiryPhoneAuthorization"
  bindphonerejected="handleInquiryPhoneRejected"
  bindmanualsubmit="handleInquiryManualSubmit"
/>
