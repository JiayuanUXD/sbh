<view id="home-ready" class="home-page">
  <view class="home-brand">
    <view class="home-brand__eyebrow">上海 · 在租房源实时同步</view>
    <view class="home-brand__title">把每一平米算清楚</view>
    <view class="home-brand__description">清楚比较单价、面积、工位与真实月租估算。</view>
    <view wx:if="{{content}}" class="home-brand__stats num">
      {{content.stats.listings}} 套在租房源 · {{content.stats.buildings}} 座精选楼宇
    </view>
  </view>

  <view class="home-search">
    <view class="home-search__city">上海<text class="home-search__arrow">▾</text></view>
    <view class="home-search__divider"></view>
    <input
      class="home-search__input"
      value="{{keyword}}"
      placeholder="搜楼盘、商圈或地铁站"
      confirm-type="search"
      bindinput="handleKeywordInput"
      bindconfirm="handleSearchSubmit"
    />
    <view
      class="home-search__submit"
      hover-class="home-search__submit--pressed"
      hover-stay-time="70"
      aria-role="button"
      aria-label="提交搜索"
      bindtap="handleSearchSubmit"
    >
      <text class="home-search__icon">🔍</text>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-loading">
    <sbh-skeleton rows="4" with-media />
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-error">
    <sbh-state
      kind="error"
      title="首页内容暂时无法加载"
      description="请检查网络后重试"
      action-label="重新加载"
      bindretry="handleRetry"
    />
  </view>

  <block wx:elif="{{state === 'ready' && content}}">
    <view wx:if="{{refreshError}}" class="home-refresh-error" aria-role="status">
      刷新未完成，当前仍显示上次内容
    </view>

    <view class="home-quick-filters">
      <view wx:for="{{content.quickFilters}}" wx:key="id" class="home-quick-filter-group">
        <view class="home-section-title">{{item.label}}</view>
        <scroll-view class="home-quick-filter-group__scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="home-quick-filter-group__options">
            <view
              wx:for="{{item.options}}"
              wx:key="value"
              class="home-quick-filter"
              hover-class="home-quick-filter--pressed"
              hover-stay-time="70"
              aria-role="link"
              data-query="{{item.query}}"
              bindtap="handleQuickFilter"
            >
              <text>{{item.label}}</text>
              <text class="home-quick-filter__count num">{{item.count}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="home-shortcuts">
        <view class="home-shortcut-card" bindtap="handleInquiryCustom">
          <view class="home-shortcut-title">委托找房</view>
          <view class="home-shortcut-desc">说需求，顾问帮你筛</view>
        </view>
        <view class="home-shortcut-card" bindtap="handleBrowseAll">
          <view class="home-shortcut-title">精选特惠</view>
          <view class="home-shortcut-desc">免租期长，房东直租</view>
        </view>
      </view>

      <view class="home-buildings-section">
        <view class="home-buildings__heading">
          <view class="home-section-title">精选好楼</view>
          <view class="home-buildings__all" bindtap="handleBrowseBuildings">全部楼盘 ›</view>
        </view>
        <scroll-view class="home-buildings__scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="home-buildings__list">
            <view class="home-building-card" bindtap="handleBuildingOpenDirect" data-slug="heng-long-plaza">
              <view class="home-building-card__badge">甲级</view>
              <view class="home-building-card__name">恒隆广场</view>
              <view class="home-building-card__desc num">静安寺 · 14套在租</view>
            </view>
            <view class="home-building-card" bindtap="handleBuildingOpenDirect" data-slug="wheelock-square">
              <view class="home-building-card__badge">甲级</view>
              <view class="home-building-card__name">会德丰广场</view>
              <view class="home-building-card__desc num">静安寺 · 9套在租</view>
            </view>
            <view class="home-building-card" bindtap="handleBuildingOpenDirect" data-slug="hkri-taikoo-hui">
              <view class="home-building-card__badge">甲级</view>
              <view class="home-building-card__name">兴业太古汇</view>
              <view class="home-building-card__desc num">南京西路 · 7套在租</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="home-featured">
      <view class="home-featured__heading">
        <view class="home-section-title">精选房源</view>
        <view class="home-featured__all" aria-role="link" bindtap="handleBrowseAll">查看全部</view>
      </view>
      <view wx:if="{{content.featuredListings.length}}" class="home-featured__list">
        <listing-card
          wx:for="{{content.featuredListings}}"
          wx:key="id"
          listing="{{item}}"
          bindopen="handleListingOpen"
        />
      </view>
      <sbh-state
        wx:else
        kind="empty"
        title="暂无精选房源"
        description="可以先查看全部在租房源"
      />
    </view>
  </block>
</view>
