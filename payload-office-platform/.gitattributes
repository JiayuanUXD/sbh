# 行尾符统一为 LF（Windows 开发 / Linux 部署统一）
# 已跟踪文本文件通过 `git add --renormalize` 一次性规范化；新增文件自动按 LF 存储
* text=auto eol=lf

# 部署包瘦身：CI 用 `git archive HEAD:payload-office-platform` 打 ZIP 上传到
# CloudBase，平台收包后才在云端 docker build。所以 .dockerignore 在这一步**不生效**
# ——包得先传上去。跨境到腾讯云 COS 的吞吐下，7.6MB 会撑爆 curl --max-time，
# 5 次重试全部 0 字节超时（run 30265028880）；297KB 时代连续 4 次部署 52s 内完成。
#
# artifacts/ 和 tests/ 既不进 Docker 构建也不进镜像（Dockerfile 只 COPY .next/public/
# src/scripts 和几个配置文件，src/ 也没有任何地方 import 这些验证产物），纯搭便车。
# 排除后包体积 7.64MB -> 869KB。
artifacts/ export-ignore
tests/ export-ignore

# 迁移 .json 快照只供 `migrate:create` 本地 diff 用；运行时 `payload migrate` 只读
# 同名 .ts（src/migrations/index.ts 也只 import .ts），构建/运行都不需要它们。
# 全目录约 20 个、压缩后 ~320KB，排除纯属给跨境上传省窗口。
src/migrations/*.json export-ignore

# 首页 hero 背景视频（1.23MB，压缩后仍占全包 ~50%）已迁移到 COS 媒体库，
# 前端改引 /api/media/file/hero-bg.mp4?prefix=media，
# 不再随部署包上传。
public/hero/ export-ignore

# 2026-10-13 第二轮瘦身：包涨到 2.99MB、要求 ≥14.9KB/s，run 38222193643 / 38266385896
# 两台 runner 十次上传均速都卡在 12–15KB/s，全部失败。下面几类都随包上传、
# 但云端构建与容器运行都用不到，合计约 450KB。
#
# scripts/：除容器 CMD 第一步的 migrate-locked.ts，其余都是带 .env.local 本地跑的
# 运维 / 种子 / 核验脚本。Dockerfile 仍 COPY scripts/，**migrate-locked.ts 必须留**，
# 少了它容器启动即失败（守卫：tests/production-deploy-config.test.ts）。
scripts/** export-ignore
scripts/migrate-locked.ts -export-ignore

# seed/：七城地理种子，只给本地 import:geography / collect:geography 用，src/ 不读。
seed/** export-ignore

# dev-story 走查页（及只被它引用的演示组件）：生产环境 notFound()。
# E2E 跑的是完整仓库，不受部署包影响。
src/app/(frontend)/dev-story/** export-ignore
src/components/frontend/dev/** export-ignore
public/dev-story/** export-ignore

# 纯文档：agent 规则与根级 md，构建与运行都不读。
.agent/** export-ignore
/*.md export-ignore
