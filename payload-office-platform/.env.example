# ──────────────────────────────────────────────────────────────
# 商办租赁平台 — 环境变量样例
# 复制为 .env.local 并填入真实值；不要提交 .env.local
# ──────────────────────────────────────────────────────────────

# Payload 会话密钥（生产请替换为长随机串）
PAYLOAD_SECRET=replace-with-a-long-random-secret

# ──────────────────────────────────────────────────────────────
# 微信小程序服务端能力（MP-104；仅服务端，禁止使用公开变量前缀）
# ──────────────────────────────────────────────────────────────

# 微信公众平台分配的 18 位小程序 AppID（wx + 16 位十六进制字符）
WECHAT_MINIPROGRAM_APP_ID=
# 微信公众平台分配的 32 位 AppSecret；不得进入日志、响应或小程序包
WECHAT_MINIPROGRAM_APP_SECRET=
# 仅用于 15 分钟匿名上下文 token；必须是密码学随机 32 字节的无填充 base64url。
# 生成示例：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MINI_SESSION_SIGNING_SECRET=
# Mini 写接口只按 X-Forwarded-For 右侧受信链解析客户 IP；仅接受 1..5。
# CloudBase 部署必须按实际反代层数配置，不得猜测；缺失/错误时 Mini POST fail-closed 503。
MINI_TRUSTED_PROXY_HOPS=

# ──────────────────────────────────────────────────────────────
# 数据库（本地/CI/生产统一 PostgreSQL，push: false，只走显式迁移）
# ──────────────────────────────────────────────────────────────

# 必须提供 postgres:// 的 DATABASE_URL；缺省或非 postgres 一律 fail-fast，不再回退 SQLite。
# 本地开发示例（自建 PG；多 worktree 各用独立库名，别共用、别指向生产 TencentDB）：
#   createdb sbh_dev
#   DATABASE_URL=postgres://<user>@localhost:5432/sbh_dev
# 生产 / 类生产：TencentDB for PostgreSQL（共享库，禁止 dev push，只走 npx payload migrate）
DATABASE_URL=postgres://user:password@host:5432/dbname

# ──────────────────────────────────────────────────────────────
# 媒体存储（当前使用 Payload 本地上传，无需以下变量）
# ──────────────────────────────────────────────────────────────
# S3 插件已卸载；如未来重新接入腾讯云 COS（S3 兼容），恢复以下变量并装回 @payloadcms/storage-s3
# S3_BUCKET=your-bucket-1250000000
# S3_REGION=ap-guangzhou
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_ACCESS_KEY_ID=your-secret-id
# S3_SECRET_ACCESS_KEY=your-secret-key

# ──────────────────────────────────────────────────────────────
# 询价接口限流（可选，默认已硬编码）
# ──────────────────────────────────────────────────────────────
# INQUIRY_RATE_LIMIT_PER_HOUR=10

# ──────────────────────────────────────────────────────────────
# 前台公开站点配置（F0.5）
# 见 src/lib/frontend/site-config.ts 与 specs/frontend-mvp/tasks.md F0.5
# ──────────────────────────────────────────────────────────────

# 站点公开 URL（不含尾斜杠，禁止 path/query/fragment）
# 生产/类生产环境必填；缺失时启动或构建会抛错
# 本地开发缺失时自动回退到 http://localhost:3717 并 warn
# NEXT_PUBLIC_SITE_URL=https://sbh-286300-10-1253925058.sh.run.tcloudbase.com

# 默认运营城市（必须在受支持白名单内：shanghai）
# 留空使用内置默认值 'shanghai'
# NEXT_PUBLIC_DEFAULT_CITY=shanghai

# 是否启用分析埋点（仅接受 'true' / '1'，区分大小写）
# 默认关闭；生产环境推荐显式设为 'true'
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# 出售频道开关（ff07d21 引入，2026-08-24 起生产打开）
# 只认精确的 'true'——'1' / 'yes' / 'TRUE' 一律视为关闭，避免宽松解析导致误开。
# 关闭时 /sale 与 /[city]/sale 恒 404、sitemap 无出售条目、后台不显示出售字段、
# mark_sold 动作被服务端拒绝。
# ⚠️ NEXT_PUBLIC_ 是构建期内联的：本地改完要重启 dev server，生产要重新部署一次才全面生效。
# NEXT_PUBLIC_SALE_CHANNEL_ENABLED=true

# 高德地图（P1 位置交通面板）
# 浏览器 JS API Key（配置域名白名单，仅前端地图渲染，暴露到前端）
# NEXT_PUBLIC_AMAP_JS_KEY=your-amap-js-key
# 服务端 WebService Key（仅服务端 POI 查询，不得暴露到浏览器/提交到仓库）
# AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# ──────────────────────────────────────────────────────────────
# 新建表单的默认供给商户（可选）
# ──────────────────────────────────────────────────────────────

# 后台新建「房源」与「楼盘-商户关系」时预选的商户名称，缺省为「官网」。
# 按名称解析而不是硬编码 id：商户表没有稳定业务码，且各环境 id 不同。
# 只会预选「启用 + 资质有效」的商户；解析不到就不给默认值（表单照常可用）。
# ⚠️ 预选此字段不等于房源前台可见——前台判的是 listing-merchant-relations
#    里的关系记录，详见 src/domain/supply/default-merchant.ts 头部说明。
# DEFAULT_SUPPLY_MERCHANT_NAME=官网
